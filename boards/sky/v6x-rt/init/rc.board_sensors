#!/bin/sh
#
# PX4 FMUv6xrt specific board sensors init
#------------------------------------------------------------------------------
#
# UART mapping on PX4 FMU-V6XRT:
#
# LPUART1       /dev/ttyS0      CONSOLE
# LPUART3       /dev/ttyS1      GPS
# LPUART4       /dev/ttyS2      TELEM1
# LPUART5       /dev/ttyS3      GPS2
# LPUART6       /dev/ttyS4      PX4IO
# LPUART8       /dev/ttyS5      TELEM2
# LPUART10      /dev/ttyS6      TELEM3
# LPUART11      /dev/ttyS7      EXT2
#
#------------------------------------------------------------------------------

# Start ADC driver for power monitoring
board_adc start

# Internal SPI IMU sensors
# ICM45686 on SPI1
#icm45686 -R 12 -s -b 1 start

# IIM42653 on SPI2
#iim42653 -s -b 2 -R 6 start

# SCH16T on SPI3 with DRDY (GPIO_AD_21 GPIO3_IO20)
# Note: No hardware reset - SCH16T uses software reset only
sch16t -R 0 -s -b 3 start

# Internal magnetometer
rm3100 -I -b 3 start
# I2C pressure sensors
icp201xx -X -a 0x63 -b 2 start  # Bus 2 is External
icp201xx -I -a 0x64 -b 3 start  # Bus 3 is Internal
